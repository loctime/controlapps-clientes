generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  LEAD
  PROSPECT
  CLIENT
  INACTIVE
}

enum CompanyCategory {
  SIN_CATEGORIA
  AGRO
  INDUSTRIA
  METALURGICA
  LOGISTICA_TRANSPORTE
  SALUD
  COMERCIO
  ALIMENTOS_BEBIDAS
  CONSTRUCCION
  TECNOLOGIA_AUTOMATIZACION
  SERVICIOS_PROFESIONALES
  MARKETING_COMUNICACION
  EDUCACION_RRHH
  FINANZAS_SEGUROS
  ORGANISMOS_INSTITUCIONES
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum InteractionType {
  NOTE
  CALL
  EMAIL
  MEETING
  WHATSAPP
}

enum CompanyBucket {
  SIN_ASIGNAR
  PROXIMOS
  FUTUROS
  MAGNATES
}

enum ServiceStatus {
  PROPUESTA
  ACTIVO
  PAUSADO
  FINALIZADO
}

enum BillingCycle {
  MENSUAL
  TRIMESTRAL
  ANUAL
  UNICO
  POR_HITO
}

enum Currency {
  ARS
  USD
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  ANULADO
}

model Company {
  id            String           @id @default(cuid())
  importKey     String?          @unique
  name          String
  status        CompanyStatus    @default(LEAD)
  category      CompanyCategory  @default(SIN_CATEGORIA)
  bucket        CompanyBucket    @default(SIN_ASIGNAR)
  keywords      String?
  industry      String?
  businessType  String?
  website       String?
  instagram     String?
  phone         String?
  email         String?
  city          String?
  country       String?
  notes         String?
  opportunitySummary String?
  proposedSolutions String?
  description   String?
  addressNotes  String?
  productsOffered String?
  productsDemanded String?
  sourceEvent   String?
  potentialValue Float?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  contacts      Contact[]
  interactions  Interaction[]
  tasks         Task[]
  services      Service[]

  @@index([status])
  @@index([name])
  @@index([bucket])
}

model Contact {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  role       String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Interaction {
  id         String          @id @default(cuid())
  companyId  String
  type       InteractionType @default(NOTE)
  subject    String
  detail     String?
  happenedAt DateTime        @default(now())
  createdAt  DateTime        @default(now())
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, happenedAt])
}

model Service {
  id             String        @id @default(cuid())
  companyId      String
  name           String
  scope          String?
  status         ServiceStatus @default(ACTIVO)
  amount         Float         @default(0)
  currency       Currency      @default(ARS)
  billingCycle   BillingCycle  @default(MENSUAL)
  startDate      DateTime      @default(now())
  endDate        DateTime?
  nextDueDate    DateTime?
  paymentMethod  String?
  needsInvoice   Boolean       @default(false)
  billingContact String?
  billingEmail   String?
  billingPhone   String?
  infraCost      Float         @default(0)
  infraNotes     String?
  url            String?
  repoUrl        String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@index([companyId])
  @@index([status])
  @@index([nextDueDate])
}

model Payment {
  id            String        @id @default(cuid())
  serviceId     String
  concept       String
  amount        Float
  currency      Currency      @default(ARS)
  dueDate       DateTime
  paidAt        DateTime?
  status        PaymentStatus @default(PENDIENTE)
  method        String?
  invoiceNumber String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  service       Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([status, dueDate])
  @@index([dueDate])
}

model Task {
  id          String        @id @default(cuid())
  companyId   String?
  title       String
  detail      String?
  dueDate     DateTime?
  priority    TaskPriority  @default(MEDIUM)
  status      TaskStatus    @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([dueDate])
  @@index([status, dueDate])
}
